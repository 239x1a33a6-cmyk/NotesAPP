# Example frontend env (for Vite)
# Copy to `frontend/.env` or set in Vercel project settings

# Backend API URL
# Local development: http://localhost:8002
# Production: https://your-backend-url.com
VITE_API_URL=http://localhost:8002

# Frontend URL (for reference/redirects if needed)
# Local development: http://localhost:5173
# Production: https://your-frontend-url.com
VITE_APP_URL=http://localhost:5173
