# Example backend environment variables
# Copy this file to `backend/.env` and fill values (DO NOT commit secrets)

# Port (Render will set this automatically)
PORT=8002

# MongoDB connection string. Use mongodb+srv form provided by Atlas and URL-encode special characters in the password.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://vinaykdmr:<ENCODED_PASSWORD>@<cluster>.mongodb.net/notesapp?retryWrites=true&w=majority

# JWT secret used to sign tokens
JWT_SECRET=your_jwt_secret_here
PORT=8002
MONGO_URL=mongodb://127.0.0.1:27017/notesapp
JWT_SECRET=your_jwt_secret_key_here
