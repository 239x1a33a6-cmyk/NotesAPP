# Example backend environment variables
# Copy this file to `backend/.env` and fill values (DO NOT commit secrets)

# ========== SERVER & PORT ==========
# Port (Render will set this automatically)
# Default: 8002
PORT=8002

# Frontend URL (for CORS configuration)
# Local development: http://localhost:5173
# Production: https://your-frontend-url.com
FRONTEND_URL=http://localhost:5173

# ========== DATABASE ==========
# MongoDB connection string. Use mongodb+srv form provided by Atlas and URL-encode special characters in the password.
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Example (Local): mongodb://127.0.0.1:27017/notesapp
MONGO_URL=mongodb://127.0.0.1:27017/notesapp

# ========== AUTHENTICATION ==========
# JWT secret used to sign tokens (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# ========== BACKEND API URL ==========
# Backend URL (for reference, used in documentation)
# Local development: http://localhost:8002
# Production: https://your-backend-url.com
BACKEND_URL=http://localhost:8002
